load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("//cuda:defs.bzl", "cuda_toolchain_config_clang", "cuda_toolchain_config_nvcc", "cuda_toolchain_config_nvcc_msvc", "cuda_toolkit_info", "merged_ctk")
load("//cuda/private:rules/merge_directory.bzl", "merge_directory")
load(":environment_test.bzl", "clang_cuda_path_test", "environment_test", "merge_directory_test", "merged_ctk_test", "msvc_device_link_flags_test", "runtime_libraries_test")

# Analysis-only archive fixtures; no compiler or GPU is needed by these tests.
[
    write_file(
        name = "write_" + name,
        out = name,
        content = [],
    )
    for name in [
        "libcudadevrt.a",
        "cudadevrt.lib",
        "libculibos.a",
    ]
]

cc_library(
    name = "linux_runtime",
    srcs = [":libcudadevrt.a"],
)

cc_import(
    name = "windows_runtime",
    interface_library = ":cudadevrt.lib",
    system_provided = True,
)

cuda_toolkit_info(
    name = "toolkit",
    bin2c = "//cuda/dummy:bin2c",
    device_runtime_static_libs = [
        ":linux_runtime",
        ":windows_runtime",
        ":libculibos.a",
    ],
    fatbinary = "//cuda/dummy:fatbinary",
    link_stub = "//cuda/dummy:link.stub",
    nvlink = "//cuda/dummy:nvlink",
    path = "C:/CUDA",
    ptxas = "//cuda/dummy:ptxas",
    version = "12.6",
)

runtime_libraries_test(
    name = "runtime_libraries_test",
    toolkit = ":toolkit",
)

[
    cuda_toolchain_config_nvcc(
        name = "nvcc_" + execution_os,
        cuda_toolkit = ":toolkit",
        exec_path_separator = separator,
        toolchain_identifier = "nvcc",
    )
    for execution_os, separator in {
        "linux": ":",
        "windows": ";",
    }.items()
]

[
    cuda_toolchain_config_nvcc_msvc(
        name = "nvcc_msvc_" + execution_os,
        cuda_toolkit = ":toolkit",
        exec_path_separator = separator,
        msvc_env_tmp = "C:/Temp",
        toolchain_identifier = "nvcc",
    )
    for execution_os, separator in {
        "linux": ":",
        "windows": ";",
    }.items()
]

# In particular, the non-MSVC config must accept Windows execution (e.g. Clang).
[
    environment_test(
        name = compiler + "_" + execution_os + "_test",
        config = ":" + compiler + "_" + execution_os,
        separator = separator,
    )
    for compiler in [
        "nvcc",
        "nvcc_msvc",
    ]
    for execution_os, separator in {
        "linux": ":",
        "windows": ";",
    }.items()
]

# nvcc must use the same host compiler and CRT for device link as for compile.
[
    msvc_device_link_flags_test(
        name = "nvcc_msvc_" + name + "_device_link_flags_test",
        config = ":nvcc_msvc_windows",
        crt_flag = crt_flag,
        requested = requested,
    )
    for name, crt_flag, requested in [
        (
            "mt",
            "/MT",
            [
                "opt",
                "static_link_msvcrt_no_debug",
            ],
        ),
        (
            "mtd",
            "/MTd",
            [
                "dbg",
                "static_link_msvcrt_debug",
            ],
        ),
        (
            "md",
            "/MD",
            [
                "opt",
                "dynamic_link_msvcrt_no_debug",
            ],
        ),
        (
            "mdd",
            "/MDd",
            [
                "dbg",
                "dynamic_link_msvcrt_debug",
            ],
        ),
    ]
]

# Synthetic component fixtures for merged_ctk tests.
[
    write_file(
        name = "fake_" + rel.replace("/", "_").replace(".", "_"),
        out = rel,
        content = ["// fixture"],
    )
    for rel in [
        "fake_nvcc/bin/ptxas",
        "fake_nvcc/LICENSE",
        "fake_cudart/include/cuda.h",
        "fake_cccl/include/cccl/thrust/version.h",
        "fake_nvvm/nvvm/include/nvvm.h",
        "fake_nvvm/nvvm/libdevice/libdevice.10.bc",
    ]
]

filegroup(
    name = "fake_nvcc_all_files",
    srcs = [
        ":fake_fake_nvcc_LICENSE",
        ":fake_fake_nvcc_bin_ptxas",
    ],
)

cc_library(
    name = "fake_cudart_headers",
    hdrs = [":fake_fake_cudart_include_cuda_h"],
    includes = ["fake_cudart/include"],
)

cc_library(
    name = "fake_cccl_headers",
    hdrs = [":fake_fake_cccl_include_cccl_thrust_version_h"],
    includes = ["fake_cccl/include/cccl"],
)

cc_library(
    name = "fake_nvvm_headers",
    hdrs = [":fake_fake_nvvm_nvvm_include_nvvm_h"],
    includes = ["fake_nvvm/nvvm/include"],
)

filegroup(
    name = "fake_nvvm_all_files",
    srcs = [
        ":fake_fake_nvvm_nvvm_include_nvvm_h",
        ":fake_fake_nvvm_nvvm_libdevice_libdevice_10_bc",
    ],
)

merged_ctk(
    name = "test_merged_ctk",
    deps = [
        ":fake_cccl_headers",
        ":fake_cudart_headers",
        ":fake_nvcc_all_files",
        ":fake_nvvm_all_files",
        ":fake_nvvm_headers",
    ],
)

merged_ctk_test(
    name = "merged_ctk_test",
    target = ":test_merged_ctk",
)

cuda_toolkit_info(
    name = "merged_ctk_toolkit",
    bin2c = "//cuda/dummy:bin2c",
    fatbinary = "//cuda/dummy:fatbinary",
    libdevice = "//cuda/dummy:libdevice.10.bc",
    link_stub = "//cuda/dummy:link.stub",
    nvlink = "//cuda/dummy:nvlink",
    path = "$(location :test_merged_ctk)",
    path_data = [":test_merged_ctk"],
    ptxas = "//cuda/dummy:ptxas",
    version = "13.0",
)

cuda_toolchain_config_clang(
    name = "clang_merged_ctk_config",
    cuda_toolkit = ":merged_ctk_toolkit",
    toolchain_identifier = "clang",
)

clang_cuda_path_test(
    name = "clang_merged_ctk_cuda_path_test",
    config = ":clang_merged_ctk_config",
)

merged_ctk(
    name = "test_dir_a",
    deps = [":fake_cudart_headers"],
)

merged_ctk(
    name = "test_dir_b",
    deps = [":fake_nvcc_all_files"],
)

merge_directory(
    name = "test_merge_directory",
    srcs = [
        ":test_dir_a",
        ":test_dir_b",
    ],
    exclude_files = ["LICENSE"],
    out = "merged_dir_out",
)

merge_directory_test(
    name = "merge_directory_test",
    target = ":test_merge_directory",
)
