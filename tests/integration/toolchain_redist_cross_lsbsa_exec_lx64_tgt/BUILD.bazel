load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

# Case 2: linux-x86_64 host, linux-sbsa exec (qemu-user/binfmt), linux-x86_64 target.
# Target is host-arch so the smoke binary can be executed on the client (no GPU).

cc_library(
    name = "use_library",
    tags = ["manual"],
    deps = ["@cuda//:cuda_runtime"],
)

cuda_library(
    name = "use_rule",
    srcs = ["@rules_cuda_examples//basic:kernel.cu"],
    hdrs = ["@rules_cuda_examples//basic:kernel.h"],
    tags = ["manual"],
)

# Host-runnable product for the intermediate-aarch exec setup (no CUDA runtime init).
cc_binary(
    name = "smoke",
    srcs = ["smoke.cpp"],
    tags = ["manual"],
)
