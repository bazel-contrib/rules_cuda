module(name = "toolchain_redist_json_missing")

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_cuda", version = "0.0.0")
local_path_override(
    module_name = "rules_cuda",
    path = "../../..",
)

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")

# 11.0 has neither requested component; 11.8 has CCCL but predates nvJitLink.
# Deliberately omit the compiler and runtime too: their absence must not prevent
# optional consumers from analyzing or silently select a local CUDA installation.
cuda.redist_json(
    name = "cuda_11_0_3",
    components = [
        "cccl",
        "nvjitlink",
    ],
    platforms = [
        "linux-x86_64",
        "windows-x86_64",
    ],
    version = "11.0.3",
)
cuda.redist_json(
    name = "cuda_11_8_0",
    components = [
        "cccl",
        "nvjitlink",
    ],
    platforms = [
        "linux-x86_64",
        "windows-x86_64",
    ],
    version = "11.8.0",
)

# Exercise the renamed CCCL key and missing CUDA 13 compiler components too.
cuda.redist_json(
    name = "cuda_13_3_1",
    components = ["cccl"],
    platforms = [
        "linux-x86_64",
        "windows-x86_64",
    ],
    version = "13.3.1",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

register_toolchains("@cuda//toolchain/...")
