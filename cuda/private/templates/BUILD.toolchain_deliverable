# Hermetic/deliverable CUDA toolchains for multi-platform redist.
#
# Emits both Linux and Windows nvcc toolchains. MODULE.bazel only registers
# nvcc-local-toolchain (host alias). Cross builds that need the non-host OS
# toolchain pass e.g. --extra_toolchains=@cuda//toolchain:nvcc-linux-toolchain.

load(
    "@rules_cuda//cuda:defs.bzl",
    "cuda_toolchain",
    "cuda_toolchain_config_nvcc",
    "cuda_toolchain_config_nvcc_msvc",
    "cuda_toolkit_info",
)

# %{toolkit_version_config_settings}

cuda_toolkit_info(
    name = "cuda-toolkit",
    bin2c = "%{bin2c_label}",
    fatbinary = "%{fatbinary_label}",
    link_stub = "%{link_stub_label}",
    nvlink = "%{nvlink_label}",
    # %{cicc_line},
    # %{libdevice_line},
    # %{device_runtime_static_libs_line}
    path = "%{cuda_path}",
    ptxas = "%{ptxas_label}",
    # %{cuda_version_line}
)

# --- Linux exec/target (gcc-style nvcc config) ---

cuda_toolchain_config_nvcc(
    name = "nvcc-linux-config",
    cuda_toolkit = ":cuda-toolkit",
    # %{nvcc_version_major_line}
    # %{nvcc_version_minor_line}
    toolchain_identifier = "nvcc",
)

cuda_toolchain(
    name = "nvcc-linux",
    # %{compiler_files_line}
    compiler_label = "%{nvcc_label}",
    toolchain_config = ":nvcc-linux-config",
)

toolchain(
    name = "nvcc-linux-toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    target_settings = [
        "@rules_cuda//cuda:is_enabled",
        "@rules_cuda//cuda:compiler_is_nvcc",
    ],
    toolchain = ":nvcc-linux",
    toolchain_type = "@rules_cuda//cuda:toolchain_type",
    visibility = ["//visibility:public"],
)

# --- Windows exec/target (MSVC nvcc config) ---

cuda_toolchain_config_nvcc_msvc(
    name = "nvcc-windows-config",
    cuda_toolkit = ":cuda-toolkit",
    msvc_env_tmp = "%{env_tmp}",
    # %{nvcc_version_major_line}
    # %{nvcc_version_minor_line}
    toolchain_identifier = "nvcc",
)

cuda_toolchain(
    name = "nvcc-windows",
    # %{compiler_files_line}
    compiler_label = "%{nvcc_label}",
    toolchain_config = ":nvcc-windows-config",
)

toolchain(
    name = "nvcc-windows-toolchain",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [
        "@rules_cuda//cuda:is_enabled",
        "@rules_cuda//cuda:compiler_is_nvcc",
    ],
    toolchain = ":nvcc-windows",
    toolchain_type = "@rules_cuda//cuda:toolchain_type",
    visibility = ["//visibility:public"],
)

# Backward-compatible name used by register_detected_cuda_toolchains().
# Prefer host-matching constraints via the platform-specific toolchains above;
# keep this alias as the Linux toolchain so hermetic Linux builds keep working
# when only nvcc-local-toolchain is registered.
alias(
    name = "nvcc-local-toolchain",
    actual = ":%{nvcc_local_actual}",
    visibility = ["//visibility:public"],
)
