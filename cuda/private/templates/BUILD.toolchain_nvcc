# This becomes the BUILD file for @cuda//toolchain/ for local and redist toolkits.

load(
    "@rules_cuda//cuda:defs.bzl",
    "cuda_toolchain",
    "cuda_toolchain_config_nvcc",
    "cuda_toolchain_config_nvcc_msvc",
    "cuda_toolkit_info",
)

# %{toolkit_version_config_settings}

cuda_toolkit_info(
    name = "cuda-toolkit",
    bin2c = "%{bin2c_label}",
    fatbinary = "%{fatbinary_label}",
    link_stub = "%{link_stub_label}",
    nvlink = "%{nvlink_label}",
    # %{cicc_line},
    # %{libdevice_line},
    # %{device_runtime_static_libs_line}
    path = "%{cuda_path}",
    ptxas = "%{ptxas_label}",
    # %{cuda_version_line}
)

cuda_toolchain_config_nvcc(
    name = "nvcc-linux-config",
    cuda_toolkit = ":cuda-toolkit",
    exec_path_separator = ":",
    # %{nvcc_version_major_line}
    # %{nvcc_version_minor_line}
    toolchain_identifier = "nvcc",
)

cuda_toolchain_config_nvcc_msvc(
    name = "nvcc-windows-config",
    cuda_toolkit = ":cuda-toolkit",
    exec_path_separator = ";",
    msvc_env_tmp = "%{env_tmp}",
    # %{nvcc_version_major_line}
    # %{nvcc_version_minor_line}
    toolchain_identifier = "nvcc",
)

alias(
    name = "nvcc-local-config",
    actual = select({
        "@platforms//os:windows": ":nvcc-windows-config",
        "//conditions:default": ":nvcc-linux-config",
    }),
)

cuda_toolchain(
    name = "nvcc-local",
    # %{compiler_files_line}
    compiler_label = "%{nvcc_label}",
    toolchain_config = ":nvcc-local-config",
)

[
    toolchain(
        name = "nvcc-{}-toolchain".format(os),
        exec_compatible_with = constraints,
        target_compatible_with = constraints,
        target_settings = [
            "@rules_cuda//cuda:is_enabled",
            "@rules_cuda//cuda:compiler_is_nvcc",
        ],
        toolchain = ":nvcc-local",
        toolchain_type = "@rules_cuda//cuda:toolchain_type",
        visibility = ["//visibility:public"],
    )
    for os, constraints in {
        "linux": ["@platforms//os:linux"],
        "windows": [
            "@platforms//os:windows",
            "@platforms//cpu:x86_64",
        ],
    }.items()
    if os in "%{nvcc_platforms}".split(",")
]

# Registration is unconfigured, so retain the detected host's default alias.
# Redist toolkits also expose the other OS for explicit remote registration.
alias(
    name = "nvcc-local-toolchain",
    actual = ":%{nvcc_local_actual}",
    visibility = ["//visibility:public"],
)
