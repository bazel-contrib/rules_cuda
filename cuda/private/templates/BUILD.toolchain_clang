# This becomes the BUILD file for @cuda//toolchain/clang if LLVM is detected

load(
    "@rules_cuda//cuda:defs.bzl",
    "cuda_toolchain",
    "cuda_toolkit_info",
    "merged_ctk",
    cuda_toolchain_config = "cuda_toolchain_config_clang",
)
load("//:defs.bzl", "if_cuda_toolkit_version_ge", "if_local_cuda_toolkit")

# Clang's CUDA driver requires a single `--cuda-path` tree containing `bin/`,
# `include/cuda.h` (for version detection — Clang has no flag to override it),
# `nvvm/libdevice/libdevice.10.bc`, and headers like `curand.h`. Deliverable
# toolkits scatter these across separate component repos, so merge them into
# one CTK directory instead of playing whack-a-mole with Clang's layout checks.
[
    merged_ctk(
        name = "merged_ctk",
        components = [
            "//:nvcc_all_files",
            "//:cccl_all_files",
            "//:cudart_all_files",
            "//:curand_all_files",
        ] + if_cuda_toolkit_version_ge(
            (13, 0),
            [
                "//:crt_all_files",
                "//:nvvm_all_files",
            ],
        ),
    )
    for _ in if_local_cuda_toolkit([], [None])
]

cuda_toolkit_info(
    name = "cuda-toolkit",
    bin2c = "%{bin2c_label}",
    fatbinary = "%{fatbinary_label}",
    link_stub = "%{link_stub_label}",
    nvlink = "%{nvlink_label}",
    # %{device_runtime_static_libs_line}
    path = if_local_cuda_toolkit("%{cuda_path}", "$(location :merged_ctk)"),
    path_data = if_local_cuda_toolkit([], [":merged_ctk"]),
    ptxas = "%{ptxas_label}",
    version = "%{cuda_version}",
)

cuda_toolchain_config(
    name = "clang-local-config",
    cuda_toolkit = ":cuda-toolkit",
    toolchain_identifier = "clang",
)

cuda_toolchain(
    name = "clang-local",
    # %{compiler_attribute_line}
    compiler_files = if_local_cuda_toolkit(["//:compiler_deps"], [":merged_ctk"]),
    toolchain_config = ":clang-local-config",
)

toolchain(
    name = "clang-local-toolchain",
    target_settings = [
        "@rules_cuda//cuda:is_enabled",
        "@rules_cuda//cuda:compiler_is_clang",
    ],
    toolchain = ":clang-local",
    toolchain_type = "@rules_cuda//cuda:toolchain_type",
    visibility = ["//visibility:public"],
)
